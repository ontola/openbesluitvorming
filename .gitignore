# Local runtime state, written by running the app or a seed script here. Only
# woozi-ops was listed, so its siblings — and every SQLite WAL sidecar —
# turned up as untracked noise on each run.
woozi-ops.sqlite3*
woozi-export-log.sqlite3*
woozi-stats-cache.json

# OpenTofu / Terraform
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform.lock.hcl

# Interne, niet-publieke documentatie (bevat gevoelige takedown-informatie)
docs_internal/

# Lokale ops-scripts voor gevoelige-data-detectie (BSN, telefoonnummers, NAW,
# vertrouwelijkheid, ...) -- bewust niet in de repo
local_scripts/
